{
  "name": "signale-mayotte-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Signale Mayotte — back-end : API Express, MariaDB (SQL) et NeDB (NoSQL). Le front-end est un projet séparé.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "server": "node src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test \"tests/unitaires/*.test.js\"",
    "test:api": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "node tests/e2e/parcours.spec.js",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "mysql2": "^3.24.6",
    "nsfwjs": "^4.3.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "playwright-chromium": "^1.61.0",
    "prettier": "^3.9.9"
  }
}
