# Copier ce fichier en ".env" (jamais commité) et remplir les valeurs réelles.

# Chaîne de connexion Postgres du projet Supabase.
# Dans Supabase : Project Settings > Database > Connection string (URI).
DATABASE_URL=

# Base de données utilisée UNIQUEMENT par "npm run test:api" (server/tests/*.test.js).
# DOIT être un projet Supabase SÉPARÉ de celui de DATABASE_URL : les tests font des
# TRUNCATE sur la table signalements à chaque exécution. Si cette variable est absente
# ou identique à DATABASE_URL, les tests refusent de démarrer pour éviter d'effacer
# des données réelles.
TEST_DATABASE_URL=

# --- Envoi des emails (codes de vérification, notifications...) ---
# Toujours par API HTTPS, jamais en SMTP : Render bloque les connexions SMTP sortantes,
# les emails ne partiraient jamais (échec silencieux).

# Brevo (https://brevo.com, gratuit 300 emails/jour) : RECOMMANDÉ sans nom de domaine.
# Il suffit de valider une adresse d'expédition (Senders & IP > Add a sender, puis
# cliquer le lien reçu), pas besoin d'acheter un domaine, et on peut écrire à n'importe qui.
# Clé : SMTP & API > API Keys.
BREVO_API_KEY=
# L'adresse validée ci-dessus, par ex. moncompte@gmail.com. Sans elle, Brevo est ignoré.
BREVO_EXPEDITEUR=

# Resend (https://resend.com) : utilisé seulement si Brevo n'est pas configuré.
# ATTENTION : sans domaine vérifié, Resend REFUSE (403) tout destinataire autre que le
# propriétaire du compte — les autres utilisateurs ne reçoivent donc jamais rien.
RESEND_API_KEY=
# Adresse d'expédition Resend (défaut : onboarding@resend.dev).
RESEND_FROM=

# Adresse qui reçoit les notifications de nouveaux signalements (optionnel, défaut : benoblock440@gmail.com)
EMAIL_DESTINATAIRE=benoblock440@gmail.com

# Identifiants d'accès au site (gate de connexion). Obligatoires.
# Choisir un mot de passe long et aléatoire (jamais le nom du site, du propriétaire, etc.).
ADMIN_IDENTIFIANT=
ADMIN_MOT_DE_PASSE=

# URL publique du site, utilisée pour construire les liens dans les emails (optionnel)
SITE_URL=http://localhost:5173

# Clé API gratuite pour les tuiles de la carte (MapTiler : https://cloud.maptiler.com/account/keys/).
# Sans cette clé, la carte utilise OpenStreetMap France en secours (fonctionne, mais moins fiable).
VITE_MAPTILER_KEY=

# Stockage des photos (Supabase Storage). Project Settings > API sur Supabase. Obligatoires.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
