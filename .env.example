# Copier ce fichier en ".env" (jamais commité) et remplir les valeurs réelles.

# Connexion à la base MariaDB (compte « signale », jamais root).
# En développement : MariaDB installé sur le PC (consultable avec DBeaver), par ex.
#   DATABASE_URL=mysql://signale:MOT_DE_PASSE@localhost:3306/signale_mayotte
# Une base sur localhost se connecte sans chiffrement ; toute autre adresse exige TLS
# avec un certificat valide (production).
# En production (alwaysdata) : dans le .env du serveur, jamais dans le dépôt.
DATABASE_URL=

# Base de données utilisée UNIQUEMENT par les tests (npm run test:api et test:e2e).
# DOIT être une base SÉPARÉE de DATABASE_URL, par ex. sur le PC :
#   TEST_DATABASE_URL=mysql://signale:MOT_DE_PASSE@localhost:3306/signale_mayotte_test
# Les tests vident la table signalements (DELETE) à chaque exécution. Si cette variable est absente
# ou identique à DATABASE_URL, les tests refusent de démarrer pour éviter d'effacer
# des données réelles.
TEST_DATABASE_URL=

# --- Envoi des emails (codes de vérification, notifications...) ---
# Toujours par API HTTPS, jamais en SMTP : beaucoup d'hébergeurs bloquent le SMTP sortant,
# les emails ne partiraient jamais (échec silencieux).

# Brevo (https://brevo.com, gratuit 300 emails/jour) : RECOMMANDÉ sans nom de domaine.
# Il suffit de valider une adresse d'expédition (Senders & IP > Add a sender, puis
# cliquer le lien reçu), pas besoin d'acheter un domaine, et on peut écrire à n'importe qui.
# Clé : SMTP & API > API Keys.
BREVO_API_KEY=
# L'adresse validée ci-dessus, par ex. moncompte@gmail.com. Sans elle, Brevo est ignoré.
BREVO_EXPEDITEUR=

# Resend (https://resend.com) : utilisé seulement si Brevo n'est pas configuré.
# ATTENTION : sans domaine vérifié, Resend REFUSE (403) tout destinataire autre que le
# propriétaire du compte — les autres utilisateurs ne reçoivent donc jamais rien.
RESEND_API_KEY=
# Adresse d'expédition Resend (défaut : onboarding@resend.dev).
RESEND_FROM=

# Adresse qui reçoit les notifications de nouveaux signalements (optionnel, défaut : benoblock440@gmail.com)
EMAIL_DESTINATAIRE=benoblock440@gmail.com

# Identifiants d'accès au site (gate de connexion). Obligatoires.
# Choisir un mot de passe long et aléatoire (jamais le nom du site, du propriétaire, etc.).
ADMIN_IDENTIFIANT=
ADMIN_MOT_DE_PASSE=

# --- Front-end (projet séparé : signale-mayotte-frontend) ---
# Adresse publique du SITE (le front), pour les liens des emails et l'export RGPD.
SITE_URL=http://localhost:5173

# Adresse(s) exacte(s) du front autorisée(s) à appeler l'API (CORS et anti-CSRF), séparées
# par des virgules, sans « / » final. Vide en développement : le front passe par le proxy
# de Vite, donc à la même adresse que l'API. En production : par ex.
#   FRONTEND_URL=https://signale.alwaysdata.net
FRONTEND_URL=

# Cookie de session. « strict » (par défaut) si le front et l'API sont sur le même site
# (même domaine). « none » s'ils sont sur deux sites différents : le cookie peut alors
# accompagner les requêtes du front (HTTPS obligatoire), la protection anti-CSRF reposant
# sur FRONTEND_URL. Attention : Safari bloque ces cookies « tiers ».
COOKIE_SAMESITE=strict

# Dossier du projet front, utilisé UNIQUEMENT par le test de parcours (npm run test:e2e).
# Par défaut : le Bureau, dossier signale-mayotte-frontend.
FRONTEND_DIR=

# Photos : rien à configurer. Elles sont rangées sur le disque du serveur
# (server/data/uploads, ignoré par git), en local comme chez alwaysdata.

# --- Journal d'activité (base NoSQL NeDB) --- Rien à configurer.
# Connexions admin/partenaire, actions sur les comptes, changements de statut… consultables
# dans l'espace admin (onglet Journal). La base est embarquée dans l'application : un
# fichier, server/data/journal/journal-activite.db (ignoré par git). Les tests utilisent
# leur propre fichier et ne touchent jamais au vrai journal.

# --- Anti-robot (Cloudflare Turnstile) --- Optionnel, fortement conseillé en production.
# Protège l'inscription, le formulaire de contact et « mot de passe oublié ».
# Clés gratuites : https://dash.cloudflare.com > Turnstile > Add widget (ajouter le domaine
# du site, et localhost pour le développement). Sans ces deux clés, le captcha est désactivé.
# Clés de TEST officielles de Cloudflare (toujours valides, pour essayer en local) :
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
