# Configuration Apache du site (hébergement alwaysdata, site de type Apache / PHP).
# Copié tel quel dans dist/ au build.

# Application à page unique : toute adresse qui n'est pas un fichier réel (ex.
# /signalements/42, /carte) renvoie index.html, et Vue Router affiche le bon écran.
RewriteEngine On
RewriteBase /

# Toute visite en HTTP (non chiffré) est renvoyée vers HTTPS. Chez alwaysdata, une visite
# chiffrée arrive avec l'en-tête « X-Forwarded-Proto: https » ; une visite en HTTP, sans
# (vérifié le 18/11/2026 ; %{HTTPS} ne marche pas ici, il vaut toujours « off »).
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

<IfModule mod_headers.c>
  # Le navigateur refusera d'être contacté en HTTP pendant un an.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Le site ne peut pas être affiché dans un cadre (anti-clickjacking).
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Espaces admin et partenaire : jamais référencés par les moteurs de recherche. Signal
  # envoyé seulement sur ces pages, au lieu de lister leur adresse dans robots.txt (que
  # tout le monde peut lire). THE_REQUEST garde l'adresse demandée, avant la réécriture.
  <If "%{THE_REQUEST} =~ m#^\S+\s/(admin|partenaire)#">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
  # Seules les fonctions du navigateur utilisées par le site sont permises, et pour lui seul
  # (position du signalement, appareil photo, partage, copie du lien).
  Header always set Permissions-Policy "geolocation=(self), camera=(self), web-share=(self), clipboard-write=(self), microphone=(), payment=(), usb=()"

  # index.html n'est jamais gardé en cache : une mise à jour du site est visible tout de
  # suite. Les fichiers de assets/ ont un nom qui change à chaque build : cache d'un an.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Fichiers de build (nom-XXXXXXXX.js / .css, le suffixe change à chaque build) : gardés
  # un an par le navigateur. Le globe (≈ 630 Ko) n'est ainsi téléchargé qu'une fois.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Logos des partenaires et icônes : une semaine.
  <FilesMatch "\.(png|svg|jpg|webp|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>
