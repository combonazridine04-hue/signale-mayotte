# Cloudflare Pages : en-têtes de sécurité (équivalent du .htaccess utilisé sur alwaysdata).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(self), web-share=(self), clipboard-write=(self), microphone=(), payment=(), usb=()

# index.html jamais en cache : une mise à jour se voit tout de suite.
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

# Les fichiers de assets/ changent de nom à chaque build : cache d'un an.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
