# Copier ce fichier en « .env » (développement) ou « .env.production » (build pour la mise
# en ligne). Ces valeurs sont lues AU BUILD et copiées dans le JavaScript envoyé au
# navigateur : elles sont publiques. Jamais de mot de passe ni de clé secrète ici.

# Adresse du back-end (API), sans « / » final.
# - En développement : laisser VIDE (Vite relaie /api vers http://localhost:3001).
# - En production chez alwaysdata : laisser VIDE aussi (API à la même adresse, sur /api).
VITE_API_URL=

# Clé gratuite des fonds de carte (https://cloud.maptiler.com/account/keys/).
# Sans elle, la carte utilise OpenStreetMap France en secours.
VITE_MAPTILER_KEY=

# Adresse de l espace admin, sans « / » (ex. espace-k7m2q9xr4). Vide = /admin.
# En production, mettre une adresse secrète : /admin affiche alors « page introuvable ».
VITE_CHEMIN_ADMIN=
